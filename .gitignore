# Exclude build directories (any folder starting with "build", anywhere; e.g.
# build/, build-release/, build-premier/, build-showcase/) and anything
# inside a "bin" folder, anywhere.
build*/
bin/

# Exclude converted resources
/src/Resource/
/res/Animation/
/res/Mappings/
/.vs
/out
CMakeSettings.json

# Exclude submodule libraries
libs/build*/
libs/download
libs/install
