# Exclude build directories (any folder starting with "build", anywhere; e.g.
# build/, build-release/, build-premier/, build-showcase/) and anything
# inside a "bin" folder, anywhere.
build*/
bin/

# Exclude converted resources
/Sonic The Hedgehog/src/Resource/
/ParadoxEngine/src/Resource/
/Sonic The Hedgehog/res/Animation/
/Sonic The Hedgehog/res/Mappings/
/.vs
/out
CMakeSettings.json

# Exclude submodule libraries
libs/build*/
libs/download
libs/install

# Tracker-specific metadata written next to the converted music; the game never reads it
Sonic The Hedgehog/res/SMPS/converted/music/*.metadata.json

# SonLVL compiles its object definitions from the .cs files and caches the result here
Sonic The Hedgehog/SonLVL INI Files/dllcache/

# The handbook's HTML is built from doc/index.docbook
Sonic The Hedgehog/doc/html/
